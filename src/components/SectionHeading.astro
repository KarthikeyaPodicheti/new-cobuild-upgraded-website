---
import { url } from '../lib/paths';

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  linkHref?: string;
  linkLabel?: string;
  dark?: boolean;
}

const {
  eyebrow,
  title,
  intro,
  linkHref,
  linkLabel = 'View all',
  dark = false,
} = Astro.props;
---

<div class:list={['section-head', dark && 'section-head--dark']}>
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
    {intro && <p class="section-head__intro">{intro}</p>}
  </div>
  {
    linkHref && (
      <a class:list={['link-cta', dark && 'link-cta--light']} href={url(linkHref)}>
        {linkLabel}
      </a>
    )
  }
</div>
