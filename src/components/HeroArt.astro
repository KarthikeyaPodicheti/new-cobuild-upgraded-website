---
// Decorative hero horizon: an original, low-contrast skyline drawn inline so
// the placeholder needs no external image. Replaced by real photography later.
---

<div class="hero-art" aria-hidden="true">
  <svg viewBox="0 0 1440 420" preserveAspectRatio="xMidYMax slice" role="presentation" focusable="false">
    <defs>
      <linearGradient id="horizon-fade" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#f7faf8" stop-opacity="0"></stop>
        <stop offset="1" stop-color="#edf5f1" stop-opacity="1"></stop>
      </linearGradient>
      <linearGradient id="horizon-near" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#d5e7df"></stop>
        <stop offset="1" stop-color="#c3dcd2"></stop>
      </linearGradient>
    </defs>

    <rect width="1440" height="420" fill="url(#horizon-fade)"></rect>

    <!-- sun -->
    <circle class="hero-sun" cx="1105" cy="118" r="88" fill="#e2f0ea"></circle>

    <!-- far skyline -->
    <g fill="#e4efe9">
      <rect x="40" y="252" width="70" height="168"></rect>
      <rect x="128" y="286" width="46" height="134"></rect>
      <rect x="210" y="232" width="58" height="188"></rect>
      <rect x="300" y="300" width="40" height="120"></rect>
      <rect x="1180" y="240" width="64" height="180"></rect>
      <rect x="1264" y="292" width="44" height="128"></rect>
      <rect x="1330" y="262" width="70" height="158"></rect>
    </g>

    <!-- mid skyline -->
    <g fill="#d8e9e1">
      <rect x="88" y="300" width="54" height="120"></rect>
      <rect x="164" y="262" width="86" height="158"></rect>
      <rect x="270" y="322" width="52" height="98"></rect>
      <rect x="352" y="280" width="38" height="140"></rect>
      <rect x="1080" y="286" width="52" height="134"></rect>
      <rect x="1150" y="314" width="38" height="106"></rect>
      <rect x="1236" y="274" width="60" height="146"></rect>
    </g>

    <!-- focal blocks -->
    <g fill="url(#horizon-near)">
      <rect x="430" y="238" width="96" height="182"></rect>
      <rect x="566" y="300" width="70" height="120"></rect>
      <rect x="690" y="212" width="112" height="208"></rect>
      <rect x="842" y="288" width="66" height="132"></rect>
      <rect x="948" y="252" width="84" height="168"></rect>
    </g>

    <!-- mullions -->
    <g stroke="#b9d5ca" stroke-width="1" opacity="0.7">
      <path d="M446 238v182M462 238v182M478 238v182M494 238v182M510 238v182"></path>
      <path d="M706 212v208M722 212v208M738 212v208M754 212v208M770 212v208M786 212v208"></path>
      <path d="M964 252v168M980 252v168M996 252v168M1012 252v168"></path>
    </g>

    <!-- ground -->
    <rect y="404" width="1440" height="16" fill="#b9d5ca"></rect>
  </svg>
</div>
