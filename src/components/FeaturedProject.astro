---
import type { Project } from '../data/projects';
import { url } from '../lib/paths';

interface Props {
  project: Project;
  reverse?: boolean;
}

const { project, reverse = false } = Astro.props;
const href = url(`/projects/${project.slug}/`);
---

<article class:list={['project-row', reverse && 'project-row--reverse']}>
  <a class="project-row__media" href={href}>
    <img
      src={url(project.image)}
      alt={`Illustration of ${project.title}`}
      width="1000"
      height="750"
      loading="lazy"
    />
    <span class={`status status--${project.status.toLowerCase()}`}>
      {project.status}
    </span>
  </a>

  <div class="project-row__body">
    <h3><a href={href}>{project.title}</a></h3>
    <p class="project-row__location">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11Z"></path>
        <circle cx="12" cy="10" r="2.5"></circle>
      </svg>
      {project.location}
    </p>
    <p class="project-row__summary">{project.summary}</p>

    <dl class="project-row__facts">
      {
        project.facts.slice(0, 3).map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))
      }
    </dl>

    <a class="link-cta" href={href}>Experience more</a>
  </div>
</article>
