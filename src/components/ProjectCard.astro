---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="project-card" data-status={project.status}>
  <div class="project-card__media">
    <img
      src={project.image}
      alt={`Illustration of ${project.title}`}
      width="640"
      height="440"
      loading="lazy"
    />
    <span class={`status status--${project.status.toLowerCase()}`}>
      {project.status}
    </span>
  </div>
  <div class="project-card__body">
    <p class="project-card__meta">{project.type} · {project.location}</p>
    <h3>{project.title}</h3>
    <p>{project.summary}</p>
    <dl class="facts">
      {
        project.facts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</article>
