---
import { navLinks, site } from '../data/site';
import { url } from '../lib/paths';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer__rule"></div>

    <div class="footer__top">
      <div class="footer__brand">
        <a class="logo" href={url('/')} aria-label={`${site.name} — home`}>
          <span class="logo__mark" aria-hidden="true">NB</span>
          <span class="logo__text">
            <strong>{site.shortName}</strong>
            <small>Infra Developers</small>
          </span>
        </a>
        <p>
          Residential communities, commercial landmarks and infrastructure —
          planned, built and handed over by one accountable team.
        </p>
        <p class="footer__contact">
          <a href={`tel:${site.phoneHref}`}>{site.phone}</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>

        <div class="social" aria-label="Social links">
          <a href={site.social[0].href} aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05C21.4 8.65 23 10.6 23 14.1V21h-4v-6.1c0-1.45-.03-3.3-2.02-3.3-2.02 0-2.33 1.57-2.33 3.2V21h-3.9V9Z"
              ></path>
            </svg>
          </a>
          <a href={site.social[1].href} aria-label="Instagram">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              aria-hidden="true"
            >
              <rect x="3" y="3" width="18" height="18" rx="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"
              ></circle>
            </svg>
          </a>
          <a href={site.social[2].href} aria-label="YouTube">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4L15.8 12l-6.2 3.6Z"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <nav class="footer__nav" aria-label="Footer">
        {navLinks.map((link) => <a href={url(link.href)}>{link.label}</a>)}
        <a href={url('/projects')}>All projects</a>
        <a href={url('/contact')}>Site visit</a>
      </nav>
    </div>

    <div class="footer__bottom">
      <p>© {year} {site.name}. All rights reserved.</p>
      <p class="footer__disclaimer">{site.reraNote}</p>
    </div>
  </div>
</footer>
