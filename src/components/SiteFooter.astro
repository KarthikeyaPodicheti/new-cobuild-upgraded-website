---
import { navLinks, site } from '../data/site';
import { projects } from '../data/projects';
import { url } from '../lib/paths';

const year = new Date().getFullYear();
const flagship = projects[0];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="logo" href={url('/')} aria-label={`${site.name} — home`}>
          <span class="logo__mark" aria-hidden="true">NB</span>
          <span class="logo__text">
            <strong>{site.shortName}</strong>
            <small>Infra Developers</small>
          </span>
        </a>
        <p>
          Residential communities, commercial landmarks and infrastructure —
          planned, built and handed over by one accountable team.
        </p>
      </div>

      <div class="footer-col">
        <h3>Company</h3>
        <ul class="footer-list">
          {
            navLinks.map((link) => (
              <li><a href={url(link.href)}>{link.label}</a></li>
            ))
          }
        </ul>
      </div>

      <div class="footer-col">
        <h3>Explore</h3>
        <ul class="footer-list">
          <li><a href={url('/projects')}>All projects</a></li>
          {
            flagship && (
              <li>
                <a href={url(`/projects/${flagship.slug}/`)}>
                  {flagship.title}
                </a>
              </li>
            )
          }
          <li><a href={url('/contact')}>Book a site visit</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h3>Visit us</h3>
        <ul class="footer-contact">
          <li>{site.address.lines.join(', ')}</li>
          <li><a href={`tel:${site.phoneHref}`}>{site.phone}</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li>{site.hours}</li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} {site.name}. All rights reserved.</p>
      <p>{site.reraNote}</p>
    </div>
  </div>
</footer>
