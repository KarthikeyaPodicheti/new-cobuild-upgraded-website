---
import { url } from '../lib/paths';

interface Props {
  title?: string;
  body?: string;
  ctaLabel?: string;
}

const {
  title = 'Thinking about a home, an office, or a land partnership?',
  body = "Tell us what you're planning. We'll come back with a straight answer, a site visit, and the documents you need to decide.",
  ctaLabel = 'Get in touch',
} = Astro.props;

const background = [
  'linear-gradient(100deg, rgba(13, 40, 33, 0.94) 0%, rgba(13, 40, 33, 0.84) 55%, rgba(13, 40, 33, 0.7) 100%)',
  `url(${url('/images/skyline-dusk.svg')})`,
].join(', ');
---

<section class="closer" style={`background-image: ${background};`}>
  <div class="container closer__inner">
    <h2>{title}</h2>
    <p>{body}</p>
    <a class="link-cta link-cta--light" href={url('/contact')}>{ctaLabel}</a>
  </div>
</section>
