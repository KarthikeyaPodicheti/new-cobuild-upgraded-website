---
// Decorative sky detail: a small aircraft crosses the hero from the left and a
// bird crosses it from the right. Purely ornamental — hidden from assistive
// technology, from anyone who prefers reduced motion, and from the text layer.
---

<div class="hero-flyers" aria-hidden="true">
  <div class="flyer flyer--plane">
    <div class="flyer__drift">
      <svg viewBox="0 0 120 62" role="presentation" focusable="false">
        <!-- vertical tail fin, swept back -->
        <path
          d="M8 26 10.6 6.4c.15-1.1 1-1.9 2.1-1.9h6.2c1.1 0 1.95.8 2.1 1.9L28 26z"
          fill="currentColor"></path>
        <!-- fuselage: rounded nose to the right, tail cone to the left -->
        <path
          d="M114 24H30C16 24 6 26 3 29.4c-.4.4-.4.8 0 1.2C6 34 16 36 30 36h84c2.2 0 4-2.7 4-6s-1.8-6-4-6z"
          fill="currentColor"></path>
        <!-- near wing, swept back and down -->
        <path d="M70 35 46 57l6-.3 24-21.7z" fill="currentColor" opacity="0.82"></path>
        <!-- cabin windows -->
        <g fill="#ffffff" opacity="0.7">
          <circle cx="80" cy="29" r="1.2"></circle>
          <circle cx="86" cy="29" r="1.2"></circle>
          <circle cx="92" cy="29" r="1.2"></circle>
          <circle cx="98" cy="29" r="1.2"></circle>
          <circle cx="104" cy="29" r="1.2"></circle>
        </g>
      </svg>
    </div>
  </div>

  <div class="flyer flyer--bird">
    <div class="flyer__drift">
      <svg viewBox="0 0 48 26" role="presentation" focusable="false">
        <g
          class="bird-wings"
          fill="none"
          stroke="currentColor"
          stroke-width="2.3"
          stroke-linecap="round"
        >
          <path d="M24 14C19.5 8.5 13 5.6 6 8.2"></path>
          <path d="M24 14C28.5 8.5 35 5.6 42 8.2"></path>
        </g>
      </svg>
    </div>
  </div>
</div>
