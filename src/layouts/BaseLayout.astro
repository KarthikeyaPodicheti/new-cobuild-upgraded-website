---
import '../styles/global.css';
import { site, navLinks } from '../data/site';
import { url } from '../lib/paths';
import larkenUrl from '../assets/fonts/Larken-Light.ttf?url';
import atlasGroteskRegularUrl from '../assets/fonts/AtlasGrotesk-Regular.otf?url';

interface Props {
  title: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url('/images/og-cover.svg'), Astro.site);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = (Astro.url.pathname.replace(base, '') || '/').replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffffff" />
    <!-- Mockup only: removed at launch. -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://upload.wikimedia.org" crossorigin />
    <link rel="preload" as="font" type="font/ttf" href={larkenUrl} crossorigin />
    <link rel="preload" as="font" type="font/otf" href={atlasGroteskRegularUrl} crossorigin />
  </head>
  <body>
    <script is:inline>document.documentElement.classList.add('js');</script>

    <a class="visually-hidden" href="#main">Skip to content</a>

    <header class="site-header" role="banner" data-header>
      <div class="container header__inner">
        <a class="logo" href={url('/')} aria-label={`${site.name} — home`}>
          <span class="logo__mark" aria-hidden="true">
            <img src={url('/images/logo-mark.svg')} alt="" width="56" height="56" />
          </span>
          <span class="logo__name">NewBuild</span>
          <span class="logo__sub">Developers</span>
        </a>

        <button
          class="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="site-nav"
          data-nav-toggle
        >
          <span class="visually-hidden">Toggle navigation</span>
          <span class="nav-toggle__bar nav-toggle__bar--top" aria-hidden="true"></span>
          <span class="nav-toggle__bar nav-toggle__bar--middle" aria-hidden="true"></span>
          <span class="nav-toggle__bar nav-toggle__bar--bottom" aria-hidden="true"></span>
        </button>

        <nav class="nav" id="site-nav" aria-label="Primary" data-nav>
          <ul class="nav__list">
            {
              navLinks.map((link) => (
                <li>
                  <a
                    class="nav__link"
                    href={url(link.href)}
                    aria-current={isActive(link.href) ? 'page' : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <div class="nav-scrim" data-nav-scrim hidden></div>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer" role="contentinfo">
      <div class="container">
        <div class="footer__rule"></div>

        <div class="footer__top">
          <div class="footer__brand">
            <a class="logo" href={url('/')} aria-label={`${site.name} — home`}>
              <span class="logo__mark" aria-hidden="true">
                <img src={url('/images/logo-mark.svg')} alt="" width="56" height="56" />
              </span>
              <span class="logo__name">NewBuild</span>
              <span class="logo__sub">Developers</span>
            </a>
            <div class="footer__social">
              <a href={site.social[0].href} aria-label="LinkedIn"
                aria-disabled={site.social[0].placeholder ? 'true' : undefined}
                title={site.social[0].placeholder ? 'Link to be configured before launch' : undefined}
                tabindex={site.social[0].placeholder ? '-1' : undefined}>
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05C21.4 8.65 23 10.6 23 14.1V21h-4v-6.1c0-1.45-.03-3.3-2.02-3.3-2.02 0-2.33 1.57-2.33 3.2V21h-3.9V9Z"></path>
                </svg>
              </a>
              <a href={site.social[1].href} aria-label="Instagram"
                aria-disabled={site.social[1].placeholder ? 'true' : undefined}
                title={site.social[1].placeholder ? 'Link to be configured before launch' : undefined}
                tabindex={site.social[1].placeholder ? '-1' : undefined}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                  <circle cx="12" cy="12" r="4"></circle>
                  <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"></circle>
                </svg>
              </a>
              <a href={site.social[2].href} aria-label="YouTube"
                aria-disabled={site.social[2].placeholder ? 'true' : undefined}
                title={site.social[2].placeholder ? 'Link to be configured before launch' : undefined}
                tabindex={site.social[2].placeholder ? '-1' : undefined}>
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4L15.8 12l-6.2 3.6Z"></path>
                </svg>
              </a>
            </div>
            <div class="footer__legal">
              <a href={url('/privacy')}>Terms</a>
              <a href={url('/privacy')}>Privacy</a>
            </div>
          </div>

          <nav class="footer__links" aria-label="Footer">
            {navLinks.map((link) => <a href={url(link.href)}>{link.label}</a>)}
          </nav>
        </div>

        <div class="footer__bottom">
          <p>© {year} {site.name}. All rights reserved.</p>
          <p>{site.reraNote}</p>
        </div>
      </div>
    </footer>

    <script is:inline>
      // ---- Mobile nav -------------------------------------------------------
      (() => {
        const toggle = document.querySelector('[data-nav-toggle]');
        const nav = document.querySelector('[data-nav]');
        const scrim = document.querySelector('[data-nav-scrim]');
        if (!toggle || !nav || !scrim) return;

        const setOpen = (open) => {
          toggle.setAttribute('aria-expanded', String(open));
          nav.classList.toggle('is-open', open);
          scrim.hidden = !open;
          scrim.classList.toggle('is-open', open);
          document.body.style.overflow = open ? 'hidden' : '';
          if (open) {
            // move focus into the panel so the next Tab stays inside it
            const first = nav.querySelector('a');
            if (first) first.focus();
          }
        };

        toggle.addEventListener('click', () => {
          setOpen(toggle.getAttribute('aria-expanded') !== 'true');
        });
        nav.addEventListener('click', (e) => {
          if (e.target.closest('a')) setOpen(false);
        });
        scrim.addEventListener('click', () => setOpen(false));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && nav.classList.contains('is-open')) {
            setOpen(false);
            toggle.focus();
          }
        });
        // when the layout grows past the breakpoint, make sure the panel resets
        const mq = window.matchMedia('(min-width: 48.0625rem)');
        mq.addEventListener('change', (e) => {
          if (e.matches && nav.classList.contains('is-open')) setOpen(false);
        });
      })();

      // ---- Sticky header hairline -----------------------------------------
      (() => {
        const header = document.querySelector('[data-header]');
        if (!header) return;
        const onScroll = () => header.classList.toggle('is-stuck', window.scrollY > 8);
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      })();

      // ---- Balloon parallax ------------------------------------------------
      (() => {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const balloons = [...document.querySelectorAll('[data-parallax]')];
        if (reduce || !balloons.length) return;

        let target = 0;
        let current = 0;
        let raf = null;

        const tick = () => {
          current += (target - current) * 0.09;
          balloons.forEach((el) => {
            const range = parseFloat(el.dataset.parallax || '20');
            el.style.setProperty('--px', `${(current * range).toFixed(2)}px`);
          });
          if (Math.abs(target - current) > 0.05) raf = requestAnimationFrame(tick);
          else raf = null;
        };

        window.addEventListener(
          'mousemove',
          (e) => {
            target = (e.clientX / window.innerWidth - 0.5) * 2;
            if (!raf) raf = requestAnimationFrame(tick);
          },
          { passive: true }
        );
      })();

      // ---- Project slider --------------------------------------------------
      (() => {
        document.querySelectorAll('[data-slider]').forEach((root) => {
          const track = root.querySelector('[data-slider-track]');
          const prev = root.querySelector('[data-slider-prev]');
          const next = root.querySelector('[data-slider-next]');
          const dotsHost = root.querySelector('[data-slider-dots]');
          if (!track) return;

          const items = [...track.children];
          const step = () => {
            const first = items[0];
            if (!first) return 320 + 32;
            return first.getBoundingClientRect().width + 32;
          };

          const page = () => {
            const perView = Math.max(1, Math.round(track.clientWidth / step()));
            return Math.max(1, items.length - perView + 1);
          };

          // Dots represent scrollable pages, not cards, so their number
          // changes with the viewport. Rebuild them whenever that changes.
          let dots = [];
          const buildDots = () => {
            if (!dotsHost) return;
            const count = page();
            if (dots.length === count) return;
            dotsHost.replaceChildren();
            dots = [];
            for (let i = 0; i < count; i += 1) {
              const dot = document.createElement('button');
              dot.type = 'button';
              dot.className = 'slider__dot';
              dot.dataset.sliderDot = '';
              dot.setAttribute('aria-label', `Go to slide ${i + 1} of ${count}`);
              dot.addEventListener('click', () => goTo(i));
              dotsHost.append(dot);
              dots.push(dot);
            }
          };

          const update = () => {
            buildDots();
            const max = track.scrollWidth - track.clientWidth;
            if (prev) prev.disabled = track.scrollLeft <= 2;
            if (next) next.disabled = track.scrollLeft >= max - 2;
            const current = Math.round(track.scrollLeft / step());
            dots.forEach((dot, i) => {
              dot.classList.toggle('is-active', i === current);
              if (i === current) dot.setAttribute('aria-current', 'true');
              else dot.removeAttribute('aria-current');
            });
          };

          const goTo = (index) => {
            const clamped = Math.max(0, Math.min(page() - 1, index));
            track.scrollTo({ left: clamped * step(), behavior: 'smooth' });
          };

          if (prev) prev.addEventListener('click', () => goTo(Math.round(track.scrollLeft / step()) - 1));
          if (next) next.addEventListener('click', () => goTo(Math.round(track.scrollLeft / step()) + 1));

          // keyboard scrolling for the track itself
          track.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowRight') { e.preventDefault(); goTo(Math.round(track.scrollLeft / step()) + 1); }
            if (e.key === 'ArrowLeft') { e.preventDefault(); goTo(Math.round(track.scrollLeft / step()) - 1); }
            if (e.key === 'Home') { e.preventDefault(); goTo(0); }
            if (e.key === 'End') { e.preventDefault(); goTo(page() - 1); }
          });

          track.addEventListener('scroll', update, { passive: true });
          window.addEventListener('resize', update);
          update();
        });
      })();

      // ---- Scroll reveals --------------------------------------------------
      (() => {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const targets = document.querySelectorAll('[data-reveal], [data-stagger]');
        if (reduce) {
          targets.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
        );
        targets.forEach((el) => observer.observe(el));
      })();
    </script>
  </body>
</html>
