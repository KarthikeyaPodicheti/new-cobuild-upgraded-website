---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PreviewBanner from '../components/PreviewBanner.astro';
import { site } from '../data/site';
import { url } from '../lib/paths';
import larkenLight from '../assets/fonts/Larken-Light.ttf?url';
import atlasRegular from '../assets/fonts/AtlasGrotesk-Regular.otf?url';

interface Props {
  title: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url('/images/og-cover.svg'), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#101b2b" />
    <!-- Mockup only: removed at launch. -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href={larkenLight} as="font" type="font/ttf" crossorigin />
    <link rel="preload" href={atlasRegular} as="font" type="font/otf" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <PreviewBanner />
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />

    <script is:inline>
      (() => {
        const reduce = window.matchMedia(
          '(prefers-reduced-motion: reduce)',
        ).matches;
        if (reduce) return;

        const selectors = [
          '.section-head',
          '.project-row',
          '.values__grid > *',
          '.principle',
          '.numbers__intro',
          '.number',
          '.legacy__inner',
          '.track-card',
          '.closer__inner',
          '.story > *',
          '.timeline li',
          '.value-card',
          '.person',
          '.check-list li',
          '.project-media',
          '.project-layout > *',
          '.gallery img',
          '.contact-grid > *',
          '.map-placeholder',
        ];

        const elements = Array.from(
          document.querySelectorAll(selectors.join(',')),
        );
        if (!elements.length) return;

        // Stagger items that sit side by side in a grid or list.
        document
          .querySelectorAll(
            [
              '.principles__grid',
              '.numbers__items',
              '.track__grid',
              '.grid-2',
              '.grid-4',
              '.gallery',
              '.timeline',
              '.check-list',
              '.values__grid',
              '.project-layout',
              '.contact-grid',
              '.story',
            ].join(','),
          )
          .forEach((group) => {
            Array.from(group.children).forEach((child, index) => {
              child.style.setProperty(
                '--reveal-delay',
                `${Math.min(index, 5) * 80}ms`,
              );
            });
          });

        let observer = null;
        try {
          observer =
            'IntersectionObserver' in window
              ? new IntersectionObserver(
                  (entries) => {
                    entries.forEach((entry) => {
                      if (!entry.isIntersecting) return;
                      entry.target.classList.add('is-visible');
                      observer?.unobserve(entry.target);
                    });
                  },
                  { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
                )
              : null;
        } catch {
          observer = null;
        }

        // Only hide content once we know we can reveal it again.
        elements.forEach((el) => el.classList.add('reveal'));

        // Observe everything, including elements already in view: the observer
        // fires on the next frame, which gives the reveal a frame to transition
        // from instead of popping in.
        if (observer) {
          elements.forEach((el) => observer?.observe(el));
        } else {
          elements.forEach((el) => el.classList.add('is-visible'));
        }

        // Slow parallax on the hero horizon.
        const art = document.querySelector('.hero-art');
        if (art) {
          let ticking = false;
          const update = () => {
            const y = Math.min(window.scrollY, window.innerHeight);
            art.style.transform = `translateY(${y * 0.06}px)`;
            ticking = false;
          };
          window.addEventListener(
            'scroll',
            () => {
              if (ticking) return;
              ticking = true;
              requestAnimationFrame(update);
            },
            { passive: true },
          );
        }
      })();
    </script>
  </body>
</html>
