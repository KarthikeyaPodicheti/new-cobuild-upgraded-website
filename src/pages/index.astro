---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroArt from '../components/HeroArt.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import CtaBand from '../components/CtaBand.astro';
import { projects, trackRecord } from '../data/projects';
import { url } from '../lib/paths';

const flagship = projects[0];

const pillars = [
  {
    icon: '01',
    title: 'Engineering-led, not brochure-led',
    text: 'In-house design coordination and site engineers own the details from foundation to finish.',
  },
  {
    icon: '02',
    title: 'Documentation you can verify',
    text: 'Approvals, titles and RERA registrations are shared before you commit — not after.',
  },
  {
    icon: '03',
    title: 'Timelines we publish',
    text: 'Every project carries a milestone schedule, and we report progress against it.',
  },
  {
    icon: '04',
    title: 'One team to handover',
    text: 'Land, design, construction and handover sit with the same accountable team.',
  },
];
---

<BaseLayout
  title="Residential and commercial developers"
  description="NewBuild plans, builds and hands over residential communities and commercial landmarks with verifiable documentation and dependable timelines."
>
  <section class="hero">
    <div class="container hero__grid">
      <div>
        <p class="eyebrow">Residential &amp; commercial developers</p>
        <h1>We build the places where <em>life and business</em> grow.</h1>
        <p class="lead">
          NewBuild plans, builds and hands over homes and workplaces — with the
          paperwork, timelines and finish quality to match the promise.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href={url('/projects')}>Explore projects</a>
          <a class="btn btn--ghost" href={url('/contact')}>Book a site visit</a>
        </div>
        <ul class="hero__proof">
          <li>RERA-compliant projects</li>
          <li>Published handover schedules</li>
          <li>In-house engineering team</li>
        </ul>
      </div>

      <HeroArt />
    </div>
  </section>

  <section class="stats" aria-label="The flagship project at a glance">
    <div class="container stats__grid">
      <div class="stat"><strong>1</strong><span>Project live now</span></div>
      <div class="stat"><strong>2.4</strong><span>Acres under development</span></div>
      <div class="stat"><strong>168</strong><span>Homes in the flagship</span></div>
      <div class="stat"><strong>2027</strong><span>Handover scheduled</span></div>
    </div>
  </section>

  <section class="section section--ink">
    <div class="container">
      <SectionHeading
        eyebrow="Now selling"
        title="The Courtyard"
        intro="Our current residential launch in Kondapur — two towers around a landscaped central court, with a rooftop clubhouse and a work-from-home lounge."
        linkHref="/projects"
        linkLabel="See the project"
      />
      {flagship && <FeaturedProject project={flagship} />}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Why NewBuild"
        title="The boring parts, done properly"
        intro="Most construction promises sound the same. The difference is in what gets documented, published and handed over."
      />
      <ul class="feature-list">
        {
          pillars.map((pillar) => (
            <li class="feature">
              <span class="feature__icon">{pillar.icon}</span>
              <div>
                <h3>{pillar.title}</h3>
                <p>{pillar.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <SectionHeading
        eyebrow="Track record"
        title="Delivered by the promoters"
        intro="Earlier developments completed by the team behind NewBuild, shown with attribution."
      />
      <div class="grid grid--3">
        {
          trackRecord.map((entry) => (
            <article class="track-card">
              <div class="track-card__media">
                <img
                  src={url(entry.image)}
                  alt={`Illustration of ${entry.title}`}
                  width="640"
                  height="440"
                  loading="lazy"
                />
              </div>
              <div class="track-card__body">
                <p class="project-card__meta">
                  {entry.location} · {entry.year}
                </p>
                <h3>{entry.title}</h3>
                <p>{entry.note}</p>
              </div>
            </article>
          ))
        }
      </div>
      <p class="note" style="margin-top: 2rem;">
        Placeholder entries. Replace with verified project names, years and
        photography, or remove this section if the promoters have no attributable
        track record.
      </p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
