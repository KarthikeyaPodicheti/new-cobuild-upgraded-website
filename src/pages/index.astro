---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects, trackRecord } from '../data/projects';
import { url } from '../lib/paths';

const flagship = projects[0];

const principles = [
  {
    num: '01',
    title: 'Engineers on site',
    text: 'Our in-house team follows the work from foundation to finish and checks the details that are easy to miss.',
  },
  {
    num: '02',
    title: 'Paperwork in the open',
    text: 'Approvals, titles, and registrations are shared up front so you can see what you are buying before you commit.',
  },
  {
    num: '03',
    title: 'Schedules you can track',
    text: 'We publish milestone dates and send progress updates as the work moves.',
  },
  {
    num: '04',
    title: 'One team responsible',
    text: 'From land purchase to handover, the same team owns the project and answers for it.',
  },
];

const numbers = [
  { value: '1', label: 'Project live now' },
  { value: '2.4', label: 'Acres under development' },
  { value: '168', label: 'Homes in flagship' },
  { value: '2027', label: 'Handover scheduled' },
  { value: '3', label: 'Delivered by promoters' },
];

const offices = [
  {
    city: 'Hyderabad',
    address: 'Kondapur, Hyderabad 500084\nTelangana, India',
    phone: '+91 40 1234 5678',
    email: 'hyderabad@newbuild.co.in',
  },
];

const caseStudy = trackRecord[0];
---

<BaseLayout
  title="Residential and commercial developers"
  description="NewBuild plans and builds residential and commercial projects, with documents and schedules you can check."
>
  <!-- Hero — Settled posture -->
  <section class="hero" data-reveal>
    <div class="hero__bg" aria-hidden="true">
      <img src={url('/images/hero-sunset.jpg')} alt="" width="2000" height="1200" loading="eager" />
    </div>
    <div class="container hero__inner">
      <div class="hero__content">
        <span class="hero__eyebrow">— Kondapur, Hyderabad</span>
        <h1>Own a piece of <span class="hero__accent">what's next</span></h1>
        <p class="lead">
          Exclusive 3 & 4 BHK homes around a landscaped central court in Kondapur.
        </p>
        <div class="hero__actions">
          <a href={url('/projects')} class="btn btn--primary hero__cta">Get early access <span class="hero__cta-arrow">→</span></a>
          <span class="hero__launch">Launching soon</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Offer — Featured Project -->
  <section class="offer" data-reveal>
    <div class="container">
      <header class="offer__header" data-reveal>
        <h2>Now selling in Kondapur</h2>
        <a href={url('/projects')} class="offer__link">View all projects</a>
      </header>
      <div class="offer__grid">
        <div class="offer__media" data-reveal>
          <div data-slot="offer" data-alt="Curved blue glass facade in diagonal panels, 160 Front Street West Toronto" style="--slot-img: url('https://upload.wikimedia.org/wikipedia/commons/thumb/a/a6/Fragment_of_160_Front_Street_West%2C_Toronto.jpg/1280px-Fragment_of_160_Front_Street_West%2C_Toronto.jpg');">
            <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/a/a6/Fragment_of_160_Front_Street_West%2C_Toronto.jpg/1280px-Fragment_of_160_Front_Street_West%2C_Toronto.jpg" alt="Curved blue glass facade in diagonal panels" width="1280" height="853" loading="lazy" />
          </div>
        </div>
        <div class="offer__content" data-reveal>
          <dl class="offer__meta">
            <dt>Status</dt>
            <dd>Limited homes available</dd>
            <dt>Location</dt>
            <dd>Kondapur, Hyderabad</dd>
            <dt>Type</dt>
            <dd>3 & 4 BHK residences</dd>
            <dt>Handover</dt>
            <dd>2027</dd>
          </dl>
          <p class="offer__description">
            Two towers around a landscaped central court, planned for light and air. The project includes a rooftop clubhouse, a work lounge, and open green space.
          </p>
          <div class="offer__facts" data-stagger>
            <div class="offer__fact">
              <span class="offer__fact-value num">168</span>
              <span class="offer__fact-label">Homes</span>
            </div>
            <div class="offer__fact">
              <span class="offer__fact-value num">2.4</span>
              <span class="offer__fact-label">Acres</span>
            </div>
            <div class="offer__fact">
              <span class="offer__fact-value num">2027</span>
              <span class="offer__fact-label">Handover</span>
            </div>
          </div>
          <a href={url('/projects/the-courtyard')} class="offer__cta">Get project details</a>
        </div>
      </div>
      <p class="offer__note">
        Placeholder project name, specifications, and imagery. Verified facts, the RERA number, and photography replace these before launch.
      </p>
    </div>
  </section>

  <!-- What we do -->
  <section class="what-we-do" data-reveal>
    <div class="container">
      <header class="what-we-do__header" data-reveal>
        <h2>How we work with buyers</h2>
        <p class="lead">We show documents early, publish dates, and keep one team on the project from start to handover.</p>
      </header>
      <div class="what-we-do__grid" data-stagger>
        {principles.map((p) => (
          <article class="what-we-do__item">
            <span class="what-we-do__num" aria-hidden="true">{p.num}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Where we are -->
  <section class="where-we-are" data-reveal>
    <div class="container">
      <header class="where-we-are__header" data-reveal>
        <h2>Visit us in Hyderabad</h2>
        <p class="lead">See the plans, walk the site, and get your questions answered in person.</p>
      </header>
      <div class="where-we-are__grid">
        <div class="where-we-are__map" data-reveal>
          <div data-slot="map" data-alt="Architectural massing model of low courtyard buildings" style="--slot-img: url('https://upload.wikimedia.org/wikipedia/commons/thumb/e/e6/Architectural_Masterplan_Model_of_Lieb_Tang_Rodfai_Villas.jpg/1280px-Architectural_Masterplan_Model_of_Lieb_Tang_Rodfai_Villas.jpg');">
            <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/e/e6/Architectural_Masterplan_Model_of_Lieb_Tang_Rodfai_Villas.jpg/1280px-Architectural_Masterplan_Model_of_Lieb_Tang_Rodfai_Villas.jpg" alt="Architectural massing model of courtyard buildings" width="1280" height="731" loading="lazy" />
          </div>
        </div>
        <div class="where-we-are__details" data-reveal>
          {offices.map((office) => (
            <div class="where-we-are__office">
              <h3>{office.city}</h3>
              <address class="where-we-are__address">{office.address.replace(/\n/g, '<br>')}</address>
              <div class="where-we-are__contact">
                <a href={`tel:${office.phone.replace(/\s/g, '')}`}>{office.phone}</a>
                <a href={`mailto:${office.email}`}>{office.email}</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Case study -->
  <section class="case-study" data-reveal>
    <div class="container">
      <header class="case-study__header" data-reveal>
        <h2>A track record you can verify</h2>
        <a href={url('/projects')} class="offer__link">Explore all work</a>
      </header>
      <div class="case-study__grid">
        <div class="case-study__media" data-reveal>
          <div data-slot="case-main" data-alt="White curved concert hall roof lit at night, Auditorio de Tenerife" style="--slot-img: url('https://upload.wikimedia.org/wikipedia/commons/thumb/f/f2/Auditorio_de_Tenerife%2C_Santa_Cruz_de_Tenerife%2C_Espa%C3%B1a%2C_2012-12-15%2C_DD_24.jpg/1280px-Auditorio_de_Tenerife%2C_Santa_Cruz_de_Tenerife%2C_Espa%C3%B1a%2C_2012-12-15%2C_DD_24.jpg');">
            <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/f/f2/Auditorio_de_Tenerife%2C_Santa_Cruz_de_Tenerife%2C_Espa%C3%B1a%2C_2012-12-15%2C_DD_24.jpg/1280px-Auditorio_de_Tenerife%2C_Santa_Cruz_de_Tenerife%2C_Espa%C3%B1a%2C_2012-12-15%2C_DD_24.jpg" alt="White curved concert hall roof lit at night" width="1280" height="754" loading="lazy" />
          </div>
        </div>
        <div class="case-study__content" data-reveal>
          <dl class="case-study__meta">
            <dt>Project</dt>
            <dd>{caseStudy.title}</dd>
            <dt>Location</dt>
            <dd>{caseStudy.location}</dd>
            <dt>Year</dt>
            <dd>{caseStudy.year}</dd>
          </dl>
          <p class="case-study__description">
            {caseStudy.note}
          </p>
          <div class="case-study__gallery" data-stagger>
            <div data-slot="case-1" data-alt="Glass office building at blue hour, Münster LVM Bürogebäude" style="--slot-img: url('https://upload.wikimedia.org/wikipedia/commons/thumb/3/3a/M%C3%BCnster%2C_LVM%2C_B%C3%BCrogeb%C3%A4ude_--_2013_--_5149-51.jpg/1280px-M%C3%BCnster%2C_LVM%2C_B%C3%BCrogeb%C3%A4ude_--_2013_--_5149-51.jpg');">
              <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/3/3a/M%C3%BCnster%2C_LVM%2C_B%C3%BCrogeb%C3%A4ude_--_2013_--_5149-51.jpg/1280px-M%C3%BCnster%2C_LVM%2C_B%C3%BCrogeb%C3%A4ude_--_2013_--_5149-51.jpg" alt="Glass office building at blue hour" width="1280" height="853" loading="lazy" />
            </div>
            <div data-slot="case-2" data-alt="Looking up a round courtyard of scattered windows, Nokia Networks Munich Office" style="--slot-img: url('https://upload.wikimedia.org/wikipedia/commons/thumb/3/3a/Nokia_Networks_Munich_Office%2C_April_2017_-02.jpg/1280px-Nokia_Networks_Munich_Office%2C_April_2017_-02.jpg');">
              <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/3/3a/Nokia_Networks_Munich_Office%2C_April_2017_-02.jpg/1280px-Nokia_Networks_Munich_Office%2C_April_2017_-02.jpg" alt="Round courtyard of scattered windows" width="1280" height="962" loading="lazy" />
            </div>
            <div data-slot="case-3" data-alt="Silhouetted spires of Prague against orange dawn sky" style="--slot-img: url('https://upload.wikimedia.org/wikipedia/commons/thumb/2/2c/Prague_skyline_at_dawn.jpg/1280px-Prague_skyline_at_dawn.jpg');">
              <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/2/2c/Prague_skyline_at_dawn.jpg/1280px-Prague_skyline_at_dawn.jpg" alt="Prague skyline at dawn" width="1280" height="773" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
      <p class="case-study__note">
        Placeholder entries. Replace with verified project names, years, and photography, or remove this section if the promoters have no attributable record.
      </p>
    </div>
  </section>

  <!-- Numbers — Figure on ink band -->
  <section class="numbers" data-reveal>
    <div class="container numbers__grid">
      <div class="numbers__figure" data-reveal>
        <span class="numbers__value num">168</span>
        <span class="numbers__label">Homes in our flagship</span>
      </div>
      <ul class="numbers__items" data-stagger>
        {numbers.map((item) => (
          <li class="numbers__item">
            <span class="numbers__item-value num">{item.value}</span>
            <span class="numbers__item-label">{item.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Close -->
  <section class="close" data-reveal>
    <div class="container">
      <h2>Talk to us about the project</h2>
      <p class="lead">
        Ask for the project dossier, schedule a site visit, or tell us what you need.
      </p>
      <div class="close__contact">
        <a href={url('/contact')}>Schedule a site visit</a>
        <a href="tel:+914012345678">Call our team</a>
      </div>
    </div>
  </section>
</BaseLayout>