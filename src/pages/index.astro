---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects, trackRecord, photos } from '../data/projects';
import { url } from '../lib/paths';

const flagship = projects[0];

const rows = [
  {
    title: flagship.title,
    location: flagship.location,
    image: photos.courtyard,
    alt: 'Curved blue glass facade of a residential tower',
    text: flagship.summary,
    href: url(`/projects/${flagship.slug}`),
    linkLabel: 'Experience more',
    flip: false,
    priority: true,
  },
  {
    title: trackRecord[0].title,
    location: trackRecord[0].location,
    image: photos.villas,
    alt: 'Architectural massing model of courtyard villas',
    text: trackRecord[0].note,
    href: url('/projects'),
    linkLabel: 'Experience more',
    flip: true,
    priority: false,
  },
  {
    title: trackRecord[1].title,
    location: trackRecord[1].location,
    image: photos.enclave,
    alt: 'City skyline at dawn',
    text: trackRecord[1].note,
    href: url('/projects'),
    linkLabel: 'Experience more',
    flip: false,
    priority: false,
  },
];

const stats = [
  { value: '42', label: 'Projects delivered' },
  { value: '1M+', label: 'Sq ft built' },
  { value: '168', label: 'Homes in our flagship' },
  { value: '2006', label: 'Building since' },
  { value: '3', label: 'Cities' },
  { value: '2027', label: 'Next handover' },
];

const sliderItems = [
  { title: trackRecord[2].title, location: trackRecord[2].location, image: photos.metro, alt: 'Glass office building at blue hour' },
  { title: flagship.title, location: flagship.location, image: photos.courtyard, alt: 'Curved blue glass facade' },
  { title: trackRecord[0].title, location: trackRecord[0].location, image: photos.villas, alt: 'Massing model of courtyard villas' },
  { title: trackRecord[1].title, location: trackRecord[1].location, image: photos.enclave, alt: 'City skyline at dawn' },
];
---

<BaseLayout
  title="Residential and commercial developers"
  description="NewBuild plans and builds residential and commercial projects, with documents and schedules you can check."
>
  <!-- Hero — white editorial -->
  <section class="hero">
    <div class="hero__art" aria-hidden="true">
      <img class="hero__balloon hero__balloon--a" src={url('/images/illustration-balloon.svg')} alt="" width="98" height="127" data-parallax="18" />
      <img class="hero__balloon hero__balloon--b" src={url('/images/illustration-balloon-accent.svg')} alt="" width="120" height="130" data-parallax="-26" />
      <img class="hero__balloon hero__balloon--c" src={url('/images/illustration-balloon.svg')} alt="" width="98" height="127" data-parallax="-34" />
    </div>

    <div class="container hero__inner">
      <h1 class="hero__title" data-reveal="left">Own a piece of <em>what's next</em></h1>
      <p class="lead hero__lead" data-reveal="left" style="transition-delay:150ms">
        3 and 4 BHK homes around a landscaped central court in Kondapur, Hyderabad. RERA registered,
        handover scheduled for 2027.
      </p>
      <a class="link hero__cta" href={url('/projects')} data-reveal="left" style="transition-delay:300ms">
        View the project
      </a>
    </div>

    <div class="hero__ground" aria-hidden="true">
      <img src={url('/images/illustration-mountains.svg')} alt="" width="1440" height="300" />
    </div>
  </section>

  <!-- Selected developments -->
  <section class="section">
    <div class="container">
      <h2 class="section-title section-title--sm" data-reveal="left">Selected developments</h2>

      {rows.map((row) => (
        <article class:list={['row', row.flip && 'row--flip']}>
          <div class="row__media" data-reveal="left">
            <img
              src={row.image}
              alt={row.alt}
              width="1280"
              height="759"
              loading={row.priority ? 'eager' : 'lazy'}
              fetchpriority={row.priority ? 'high' : 'auto'}
              decoding="async"
            />
          </div>
          <div class="row__body" data-reveal="left" style="transition-delay:100ms">
            <h3 class="row__title">{row.title}</h3>
            <p class="row__location">
              <img src={url('/images/pin.svg')} alt="" width="18" height="18" loading="lazy" />
              {row.location}
            </p>
            <p class="row__text">{row.text}</p>
            <a class="link row__link" href={row.href}>{row.linkLabel}</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Values — dark band -->
  <section class="band band--dark section">
    <div class="container band__grid">
      <div class="band__art" data-reveal="grow">
        <img src={url('/images/illustration-tower.svg')} alt="" width="524" height="480" loading="lazy" />
      </div>
      <div class="band__body">
        <h2 class="section-title section-title--lg" data-reveal="left">How we work with buyers</h2>
        <p class="lead lead--light" data-reveal="left" style="transition-delay:200ms">
          One team carries a project from land purchase to handover. We publish the approvals, keep to
          the milestone schedule, and report progress against it as the work moves.
        </p>
        <a class="link link--light" href={url('/about')} data-reveal="left" style="transition-delay:300ms">
          Read about us
        </a>
      </div>
    </div>
  </section>

  <!-- Numbers -->
  <section class="section">
    <div class="container stats__grid">
      <div class="stats__intro" data-reveal="grow">
        <h2 class="section-title section-title--lg">Building up</h2>
        <p class="lead lead--lg" style="margin-top:var(--space-md)">
          We have been building in this region since 2006. Here is where that adds up today.
        </p>
      </div>
      <ul class="stats__list" data-stagger>
        {stats.map((stat) => (
          <li>
            <span class="stats__value num">{stat.value}</span>
            <span class="stats__label">{stat.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Legacy banner with responsive srcset and sizes -->
  <section class="banner">
    <div class="banner__media" aria-hidden="true">
      <img
        src={url('/images/hero-sunset.webp')}
        srcset={`${url('/images/hero-sunset-sm.webp')} 800w, ${url('/images/hero-sunset.webp')} 2400w`}
        sizes="(max-width: 50rem) 100vw, 1360px"
        alt=""
        width="2400"
        height="1603"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="container banner__inner">
      <p class="banner__text" data-reveal="left">
        Our record is built one approval, one schedule and one handover at a time.
      </p>
    </div>
  </section>

  <!-- Other projects — dark band with slider -->
  <section class="band band--dark section">
    <div class="container" data-slider>
      <h2 class="section-title section-title--accent" data-reveal="left">Other projects</h2>

      <div class="slider" data-reveal>
        <div class="slider__track" data-slider-track tabindex="0" role="group"
            aria-label="Project carousel — use the arrow keys or the buttons below to browse">
          {sliderItems.map((item) => (
            <div class="slider__item">
              <a class="slider__card" href={url('/projects')}>
                <span class="slider__card-media">
                  <img src={item.image} alt={item.alt} width="1280" height="759" loading="lazy" decoding="async" />
                </span>
                <span class="slider__card-title">{item.title}</span>
                <span class="slider__card-location">
                  <img src={url('/images/pin.svg')} alt="" width="20" height="20" loading="lazy" />
                  {item.location}
                </span>
              </a>
            </div>
          ))}
        </div>

        <div class="slider__controls">
          <div class="slider__dots" data-slider-dots></div>
          <div class="slider__arrows">
            <button class="slider__arrow" type="button" aria-label="Previous projects" data-slider-prev>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
            <button class="slider__arrow" type="button" aria-label="Next projects" data-slider-next>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Closer -->
  <section class="closer">
    <div class="closer__media" aria-hidden="true">
      <img src={photos.tower} alt="" width="1280" height="754" loading="lazy" decoding="async" />
    </div>
    <div class="container closer__inner">
      <h2 class="closer__title section-title--light" data-reveal="grow-big">
        Let us build something worth living in
      </h2>
      <p class="closer__text" data-reveal="grow" style="transition-delay:200ms">
        Ask for the project dossier, schedule a site visit, or tell us what you need.
      </p>
      <a class="link link--light" href={url('/contact')} data-reveal="bottom">
        Get in touch
      </a>
    </div>
  </section>
</BaseLayout>
