---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';

const services = [
  {
    title: 'Residential development',
    intro:
      'Apartments, villas and gated communities for end users and land partners — planned around light, ventilation and everyday storage.',
    points: [
      '2, 3 and 4 bedroom apartments and courtyard villas',
      'Vaastu-aware planning without compromising layouts',
      'Clubhouse, landscaping and amenity delivery',
      'Maintenance and handover support after possession',
    ],
  },
  {
    title: 'Commercial & retail',
    intro:
      'Grade-A offices, retail high streets and mixed-use assets planned for occupancy, footfall and long-term rental value.',
    points: [
      'Grade-A office floors with efficient column grids',
      'Double-height retail frontage and signage zones',
      'Parking, power backup and building management systems',
      'Anchor-tenant fit-out coordination',
    ],
  },
  {
    title: 'Plotted & township development',
    intro:
      'Master-planned layouts delivered with the infrastructure buyers actually check — roads, drainage, water and titles.',
    points: [
      'Master planning and phased layout approvals',
      'Roads, street lighting, drainage and utility corridors',
      'Parks, avenue plantation and community amenities',
      'Plot-by-plot registration with clear titles',
    ],
  },
  {
    title: 'Infrastructure & EPC',
    intro:
      'Civil, road and utility works for public and private clients, executed to specification with programme reporting.',
    points: [
      'Roads, drainage, water and utility networks',
      'Civil works for industrial and institutional clients',
      'Programme and cost reporting against baseline',
      'Third-party quality and safety audits',
    ],
  },
];

const process = [
  { title: 'Enquiry & brief', text: 'We understand the requirement, budget and decision timeline before proposing anything.' },
  { title: 'Feasibility & design', text: 'Site assessment, zoning, cost plan and a design direction you can review.' },
  { title: 'Approvals & documentation', text: 'Statutory approvals, title checks and the RERA registration pathway.' },
  { title: 'Construction & QA', text: 'Milestone-based construction with stage-wise quality checks and progress reports.' },
  { title: 'Handover & support', text: 'Snag closure, documentation, possession and post-handover support.' },
];

const commitments = [
  'Published material specifications and approved samples',
  'Stage-wise quality checks with records shared on request',
  'Monthly progress reporting against the committed schedule',
  'Site safety plan with incident reporting',
  'Warranty and defect-liability terms stated in the agreement',
];
---

<BaseLayout
  title="Services"
  description="Residential, commercial, plotted development and infrastructure services — feasibility, approvals, construction and handover under one accountable team."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Services</p>
      <h1>From land to handover, under one accountable team.</h1>
      <p class="lead">
        We take on the whole brief — feasibility, design coordination,
        approvals, construction and handover — or plug into the stage you need.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {
        services.map((service, index) => (
          <article class="service-block">
            <div>
              <span class="service-block__index">0{index + 1}</span>
              <h2>{service.title}</h2>
              <p class="lead">{service.intro}</p>
            </div>
            <ul class="check-list">
              {service.points.map((point) => <li>{point}</li>)}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <p class="eyebrow">How we work</p>
      <h2 style="margin-top: 0.85rem; font-size: clamp(1.85rem, 3.5vw, 2.6rem);">
        Five stages, each with a deliverable
      </h2>
      <ol class="process" style="margin-top: 2rem;">
        {
          process.map((step) => (
            <li>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">Commitments</p>
        <h2 style="margin-top: 0.85rem; font-size: clamp(1.85rem, 3.5vw, 2.6rem);">
          Quality is a paper trail
        </h2>
        <p class="lead" style="margin-top: 0.9rem;">
          Anyone can promise good construction. We would rather give you the
          records that prove it.
        </p>
      </div>
      <ul class="check-list">
        {commitments.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <CtaBand
    title="Have land, capital, or a requirement?"
    body="Tell us the stage you are at. We will tell you honestly whether we are the right team for it."
  />
</BaseLayout>
