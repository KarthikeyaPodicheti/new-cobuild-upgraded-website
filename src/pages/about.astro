---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/paths';
import { photos } from '../data/projects';

const values = [
  {
    title: 'Paperwork you can check',
    text: 'We verify titles, approvals and registrations and share them before money moves.',
  },
  {
    title: 'Care in construction',
    text: 'We publish material specifications, approve samples, and run quality checks at each stage, not only at handover.',
  },
  {
    title: 'Dates we stand behind',
    text: 'We commit to a milestone schedule at booking and report progress against it during construction.',
  },
  {
    title: 'Planning for the neighbourhood',
    text: 'We plan water, drainage, access and landscaping with the area around the site, not just inside the boundary.',
  },
];

const milestones = [
  { year: '2006', title: 'The company is founded', text: 'Starts with civil works and small residential mandates in Hyderabad.' },
  { year: '2011', title: 'First residential project', text: 'A 96-home community delivered two months ahead of schedule.' },
  { year: '2015', title: 'Commercial development', text: 'Enters Grade-A office and retail construction with a 220,000 sq ft build.' },
  { year: '2019', title: 'One million sq ft delivered', text: 'Crosses the million-square-foot mark across residential and commercial.' },
  { year: '2023', title: 'First township handover', text: 'Sunrise Enclave handed over plot-by-plot with completed infrastructure.' },
  { year: '2026', title: 'Forty-two projects', text: 'Operating across three cities with residential, commercial and infrastructure mandates.' },
];

const credentials = [
  'RERA registration published for every project',
  'Clear title and encumbrance certificates shared upfront',
  'Statutory approvals tracked and disclosed at each stage',
  'Stage-wise QA/QC checks with third-party audits on request',
  'Site safety plan and monthly safety reporting',
];

const faqs = [
  {
    question: 'How do we verify property titles and encumbrances?',
    answer:
      'We conduct a thorough 30-year search through the sub-registrar office, obtain certificates of encumbrance, and commission independent legal opinions from senior property advocates. All title documents and search reports are shared upfront in the buyer\'s due diligence packet.',
  },
  {
    question: 'When is RERA registration made available to buyers?',
    answer:
      'Every project is registered with the state Real Estate Regulatory Authority before public booking commences. The official RERA registration number, sanctioned layout plans, project account details, and quarterly progress disclosures are published on both the authority\'s portal and our website.',
  },
  {
    question: 'How are construction milestones tracked and reported?',
    answer:
      'We tie customer installments strictly to structural milestones (foundation, plinth, slab casting, brickwork, MEP, and handover). Each milestone is verified by chartered civil engineers and accompanied by high-resolution photographic audit reports sent directly to buyers.',
  },
  {
    question: 'Can buyers inspect material testing and QA/QC certifications?',
    answer:
      'Yes. Batch test reports for concrete compressive strength, steel tensile test certificates, and waterproofing flood test sign-offs are archived in the site technical office and available for inspection by buyers or their structural consultants at any time.',
  },
];
---

<BaseLayout
  title="About us"
  description="How NewBuild plans, documents, and hands over residential and commercial projects."
>
  <section class="page-hero">
    <div class="page-hero__art" aria-hidden="true">
      <img src={url('/images/illustration-trees.svg')} alt="" width="600" height="220" loading="lazy" />
    </div>
    <div class="container">
      <span class="eyebrow">About NewBuild</span>
      <h1 class="page-hero__title" data-reveal="left">We show the work as we build it.</h1>
      <p class="lead page-hero__lead" data-reveal="left" style="transition-delay:150ms">
        Buying property means trusting a plan. We share documents, dates and site progress so you can
        check what is happening.
      </p>

      <div class="hero-stats" data-stagger>
        <div class="hero-stats__item">
          <span class="hero-stats__num">42</span>
          <span class="hero-stats__label">Projects delivered</span>
        </div>
        <div class="hero-stats__item">
          <span class="hero-stats__num">1M+</span>
          <span class="hero-stats__label">Square feet delivered</span>
        </div>
        <div class="hero-stats__item">
          <span class="hero-stats__num">20</span>
          <span class="hero-stats__label">Years of building</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="row">
        <div class="row__body row__body--roomy" data-reveal="left">
          <h2 class="section-title">One team, one brief</h2>
          <p class="body-text" style="margin-top:var(--space-lg)">
            We handle land, design, approvals and construction as one job. At each stage we share
            documents so buyers, tenants and partners can review the work.
          </p>
          <p class="body-text">
            The same team stays with a project from feasibility to handover, so decisions do not get
            lost between consultants. We are not trying to be the fastest builder. We set a realistic
            date, report against it, and hand over a building that does not need a round of fixes.
          </p>
          <a class="link row__link" href={url('/projects')}>See what we have built</a>
        </div>
        <div class="row__media" data-reveal="left" style="transition-delay:100ms">
          <img src={photos.villas} alt="Architectural massing model of courtyard buildings" width="1280" height="731" loading="lazy" decoding="async" />
        </div>
      </div>
    </div>
  </section>

  <section class="band band--dark section">
    <div class="container band__grid">
      <div class="band__art" data-reveal="grow">
        <img src={url('/images/illustration-tower.svg')} alt="" width="524" height="480" loading="lazy" />
      </div>
      <div class="band__body">
        <h2 class="section-title section-title--lg" data-reveal="left">Our values</h2>
        <p class="lead lead--light" data-reveal="left" style="transition-delay:200ms">
          Four principles we hold to on every project.
        </p>
        <ul class="list-check" data-stagger style="margin-top:var(--space-xl)">
          {values.map((value) => (
            <li>
              <strong>{value.title}</strong>
              <span>{value.text}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title" data-reveal="left">Milestones</h2>
      <div class="timeline" data-stagger style="margin-top:var(--space-2xl)">
        {milestones.map((m) => (
          <div class="timeline__item">
            <span class="timeline__year">{m.year}</span>
            <div>
              <h3 class="timeline__title">{m.title}</h3>
              <p class="timeline__text">{m.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="row">
        <div class="row__media" data-reveal="left">
          <img src={photos.tower} alt="Illuminated facade of a city building at night" width="1280" height="853" loading="lazy" decoding="async" />
        </div>
        <div class="row__body" data-reveal="left" style="transition-delay:100ms">
          <h2 class="section-title">Credentials</h2>
          <p class="body-text" style="margin-top:var(--space-lg)">
            Ask for any of these at enquiry; they are part of the sales pack, not a favour.
          </p>
          <ul class="list-check" style="margin-top:var(--space-lg)">
            {credentials.map((item) => <li>{item}</li>)}
          </ul>
          <a class="link row__link" href={url('/contact')}>Request the full pack</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Due Diligence & Transparency Accordions — Baseline 2024 exclusive accordions with native name attribute -->
  <section class="section section--tint">
    <div class="container">
      <span class="eyebrow">Buyer Assurance</span>
      <h2 class="section-title section-title--sm" data-reveal="left">Paperwork & due diligence</h2>
      <p class="lead" style="margin-top:var(--space-md)">
        Standard regulatory disclosures, legal verifications, and quality assurance protocols shared with every prospective buyer.
      </p>

      <div class="faq-list" data-stagger style="margin-top:var(--space-2xl)">
        {faqs.map((faq) => (
          <details class="faq-item" name="due-diligence">
            <summary class="faq-summary">
              <span>{faq.question}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </summary>
            <div class="faq-content">
              <p class="body-text">{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="closer">
    <div class="closer__media" aria-hidden="true">
      <img
        src={url('/images/hero-sunset.webp')}
        srcset={`${url('/images/hero-sunset-sm.webp')} 800w, ${url('/images/hero-sunset.webp')} 2400w`}
        sizes="(max-width: 50rem) 100vw, 100vw"
        alt=""
        width="2400"
        height="1603"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="container closer__inner">
      <h2 class="closer__title" data-reveal="grow-big">Want to see the paperwork?</h2>
      <p class="closer__text" data-reveal="grow" style="transition-delay:200ms">
        Ask for the project dossier or schedule a site visit.
      </p>
      <a class="link link--light" href={url('/contact')} data-reveal="bottom">Get in touch</a>
    </div>
  </section>
</BaseLayout>
