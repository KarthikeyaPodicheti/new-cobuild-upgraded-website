---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/paths';

const values = [
  {
    title: 'Paperwork you can check',
    text: 'We verify titles, approvals, and registrations and share them before money moves.',
  },
  {
    title: 'Care in construction',
    text: 'We publish material specifications, approve samples, and run quality checks at each stage, not only at handover.',
  },
  {
    title: 'Dates we stand behind',
    text: 'We commit to a milestone schedule at booking and report progress against it during construction.',
  },
  {
    title: 'Planning for the neighbourhood',
    text: 'We plan water, drainage, access, and landscaping with the area around the site, not just inside the boundary.',
  },
];

const milestones = [
  { year: '2008', title: 'The company is founded', text: 'Starts with civil works and small residential mandates in Hyderabad.' },
  { year: '2011', title: 'First residential project', text: 'A 96-home community delivered two months ahead of schedule.' },
  { year: '2015', title: 'Commercial development', text: 'Enters Grade-A office and retail construction with a 220,000 sq ft build.' },
  { year: '2019', title: 'One million sq ft delivered', text: 'Crosses the million-square-foot mark across residential and commercial.' },
  { year: '2023', title: 'First township handover', text: 'Sunrise Enclave handed over plot-by-plot with completed infrastructure.' },
  { year: '2026', title: 'Forty-two projects', text: 'Operating across three cities with residential, commercial and infrastructure mandates.' },
];

const credentials = [
  'RERA registration published for every project',
  'Clear title and encumbrance certificates shared upfront',
  'Statutory approvals tracked and disclosed at each stage',
  'Stage-wise QA/QC checks with third-party audits on request',
  'Site safety plan and monthly safety reporting',
];
---

<BaseLayout
  title="About us"
  description="How NewBuild plans, documents, and hands over residential and commercial projects."
>
  <section class="hero" data-reveal>
    <div class="hero__bg" aria-hidden="true">
      <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/e/e5/Exterior_view_of_the_illuminated_facade_of_Maison_Herm%C3%A8s%2C_Ginza%2C_Tokyo%2C_Japan.jpg/1280px-Exterior_view_of_the_illuminated_facade_of_Maison_Herm%C3%A8s%2C_Ginza%2C_Tokyo%2C_Japan.jpg" alt="" width="1280" height="853" loading="eager" />
    </div>
    <div class="container hero__inner">
      <div class="hero__content">
        <span class="hero__eyebrow">About NewBuild</span>
        <h1>We show the work as we build it.</h1>
        <p class="lead">
          Buying property means trusting a plan. We share documents, dates, and site progress so you can check what is happening.
        </p>
      </div>
    </div>
  </section>

  <section class="offer" data-reveal>
    <div class="container">
      <header class="offer__header">
        <h2>One team, one brief</h2>
      </header>
      <div class="offer__grid">
        <div class="offer__content">
          <p class="offer__description">
            We handle land, design, approvals, and construction as one job. At each stage we share documents so buyers, tenants, and partners can review the work.
          </p>
          <p class="offer__description">
            The same team stays with a project from feasibility to handover, so decisions do not get lost between consultants. We do not try to be the fastest builder. We set a realistic date, report against it, and hand over a building that does not need a round of fixes.
          </p>
        </div>
        <div class="offer__media">
          <div data-slot="about" data-alt="Architectural massing model of low courtyard buildings" style="--slot-img: url('https://upload.wikimedia.org/wikipedia/commons/thumb/e/e6/Architectural_Masterplan_Model_of_Lieb_Tang_Rodfai_Villas.jpg/1280px-Architectural_Masterplan_Model_of_Lieb_Tang_Rodfai_Villas.jpg');">
            <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/e/e6/Architectural_Masterplan_Model_of_Lieb_Tang_Rodfai_Villas.jpg/1280px-Architectural_Masterplan_Model_of_Lieb_Tang_Rodfai_Villas.jpg" alt="Architectural massing model" width="1280" height="731" loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="what-we-do" data-reveal>
    <div class="container">
      <header class="what-we-do__header">
        <h2>Our values</h2>
        <p class="lead">Four principles we hold to on every project.</p>
      </header>
      <div class="what-we-do__grid" data-stagger>
        {values.map((value) => (
          <article class="what-we-do__item">
            <h3>{value.title}</h3>
            <p>{value.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="case-study" data-reveal>
    <div class="container">
      <header class="case-study__header">
        <h2>Credentials</h2>
      </header>
      <div class="offer__grid">
        <div class="offer__content">
          <p class="offer__description">Ask for any of these at enquiry; they are part of the sales pack, not a favour.</p>
          <ul style="display: grid; gap: var(--space-md); padding-left: var(--space-lg); color: var(--color-ink-2);">
            {credentials.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="close" data-reveal>
    <div class="container">
      <h2>Want to see the paperwork?</h2>
      <p class="lead">Ask for the project dossier or schedule a site visit.</p>
      <div class="close__contact">
        <a href={url('/contact')}>Schedule a site visit</a>
        <a href={url('/projects')}>View projects</a>
      </div>
    </div>
  </section>
</BaseLayout>
