---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects, photos } from '../../data/projects';
import { url } from '../../lib/paths';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

const IMG = {
  courtyard:
    'https://upload.wikimedia.org/wikipedia/commons/thumb/a/a6/Fragment_of_160_Front_Street_West%2C_Toronto.jpg/1280px-Fragment_of_160_Front_Street_West%2C_Toronto.jpg',
};
---

<BaseLayout title={project.title} description={project.summary}>
  <section class="page-hero">
    <div class="page-hero__art" aria-hidden="true">
      <img src={url('/images/illustration-trees.svg')} alt="" width="600" height="220" loading="lazy" />
    </div>
    <div class="container">
      <span class="eyebrow">{project.type} · {project.location}</span>
      <h1 class="page-hero__title" data-reveal="left">{project.title}</h1>
      <p class="lead page-hero__lead" data-reveal="left" style="transition-delay:150ms">{project.summary}</p>
      <div style="margin-top:var(--space-xl)">
        <a class="link" href={url('/contact')}>Book a site visit</a>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="row">
        <div class="row__media" data-reveal="left">
          <img src={photos.courtyard} alt={`${project.title} visual`} width="1280" height="759" loading="lazy" decoding="async" />
        </div>
        <div class="row__body" data-reveal="left" style="transition-delay:100ms">
          <h2 class="section-title">At a glance</h2>
          <dl class="detail-list" style="margin-top:var(--space-xl);grid-template-columns:1fr">
            {project.facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
          <p class="body-text" style="margin-top:var(--space-lg)">{project.description}</p>
          <a class="link row__link" href={url('/contact')}>Request the brochure</a>
        </div>
      </div>
      <p class="note">
        Placeholder project details. Verified facts, the RERA number and photography replace these
        before launch.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title" data-reveal="left">Gallery</h2>
      <div class="gallery" data-stagger style="margin-top:var(--space-2xl)">
        {project.gallery.map((src, i) => (
          <img src={src} alt={`${project.title} — gallery image ${i + 1}`} width="1280" height="759" loading="lazy" decoding="async" />
        ))}
      </div>
      <p class="note">Placeholder images. Real project photography replaces these before launch.</p>
    </div>
  </section>

  <section class="closer">
    <div class="closer__media" aria-hidden="true">
      <img src={photos.courtyard} alt="" width="1280" height="759" loading="lazy" decoding="async" />
    </div>
    <div class="container closer__inner">
      <h2 class="closer__title" data-reveal="grow-big">See the site before you decide</h2>
      <p class="closer__text" data-reveal="grow" style="transition-delay:200ms">
        Book a visit and we will walk you through the layout, the specification and the paperwork.
      </p>
      <a class="link link--light" href={url('/contact')} data-reveal="bottom">Get in touch</a>
    </div>
  </section>
</BaseLayout>
