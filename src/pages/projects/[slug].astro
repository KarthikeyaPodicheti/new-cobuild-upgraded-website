---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import { projects } from '../../data/projects';
import { url } from '../../lib/paths';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<BaseLayout title={project.title} description={project.summary}>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">{project.type} · {project.location}</p>
      <h1>{project.title}</h1>
      <p class="lead">{project.summary}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href={url('/contact')}>Book a site visit</a>
        <a class="btn btn--ghost" href={url('/projects')}>All projects</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="project-media">
        <img
          src={url(project.image)}
          alt={`Illustration of ${project.title}`}
          width="1200"
          height="720"
        />
        <span class={`status status--${project.status.toLowerCase()}`}>
          {project.status}
        </span>
      </div>

      <div class="project-layout">
        <div class="prose">
          <p class="eyebrow">About the project</p>
          <h2 style="margin-top: 0.85rem; font-size: clamp(1.7rem, 3vw, 2.4rem);">
            Designed around the courtyard
          </h2>
          <p style="margin-top: 1rem;">{project.description}</p>
          <p style="margin-top: 1rem;">
            Floor plans, specifications and the approval set are shared at the
            site visit, together with the RERA registration and the milestone
            schedule.
          </p>
          <p class="note" style="margin-top: 1.5rem;">
            Placeholder project details. The Client supplies verified facts,
            RERA number and photography before launch.
          </p>
        </div>

        <aside class="project-facts">
          <h2>At a glance</h2>
          <dl class="facts facts--stacked">
            {
              project.facts.map((fact) => (
                <div>
                  <dt>{fact.label}</dt>
                  <dd>{fact.value}</dd>
                </div>
              ))
            }
          </dl>
          <a class="btn btn--ink" href={url('/contact')}>Request the brochure</a>
        </aside>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <p class="eyebrow">Gallery</p>
      <h2 style="margin-top: 0.85rem; font-size: clamp(1.7rem, 3vw, 2.4rem);">
        A first look
      </h2>
      <p class="lead" style="margin-top: 0.75rem; max-width: 60ch;">
        Placeholder artwork. Real project photography replaces these images
        before launch.
      </p>
      <div class="gallery">
        {
          project.gallery.map((src) => (
            <img src={url(src)} alt="" width="640" height="440" loading="lazy" />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">Location</p>
        <h2 style="margin-top: 0.85rem; font-size: clamp(1.7rem, 3vw, 2.4rem);">
          {project.location}
        </h2>
        <p class="lead" style="margin-top: 0.9rem;">
          Close to schools, daily retail and the city’s main employment corridor.
          Exact distances and the location map are confirmed at the site visit.
        </p>
      </div>
      <div class="map-placeholder" role="img" aria-label="Map placeholder">
        <span>
          Map embed placeholder<br />
          {project.location}
        </span>
      </div>
    </div>
  </section>

  <CtaBand
    title="See the site before you decide."
    body="Book a visit and we will walk you through the layout, the specification and the paperwork — including the RERA registration."
  />
</BaseLayout>
