---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/paths';
---

<BaseLayout
  title="Page not found"
  description="The page you were looking for could not be found."
>
  <section class="page-hero">
    <div class="page-hero__art" aria-hidden="true">
      <img src={url('/images/illustration-trees.svg')} alt="" width="600" height="220" loading="lazy" />
    </div>
    <div class="container">
      <span class="eyebrow">404</span>
      <h1 class="page-hero__title" data-reveal="left">This page has moved, or never existed.</h1>
      <p class="lead page-hero__lead" data-reveal="left" style="transition-delay:150ms">
        Check the address, or head back to the projects and contact pages to find what you need.
      </p>
      <div style="margin-top:var(--space-xl);display:flex;gap:var(--space-2xl);flex-wrap:wrap">
        <a class="link" href={url('/')}>Back to home</a>
        <a class="link" href={url('/projects')}>View projects</a>
      </div>
    </div>
  </section>
</BaseLayout>
