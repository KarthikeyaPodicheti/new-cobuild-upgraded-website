---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Contact"
  description="Talk to NewBuild about a home, commercial space or a site visit."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h1>Let's talk about what you're planning.</h1>
      <p class="lead">
        Whether it is a first home or an office requirement, start with a short
        brief. We reply within one working day.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <div>
        <p class="eyebrow">Reach us</p>
        <h2>Office and site visits</h2>

        <dl class="contact-list">
          <div>
            <dt>Head office</dt>
            <dd>{site.address.lines.join(', ')}</dd>
          </div>
          <div>
            <dt>Phone</dt>
            <dd><a href={`tel:${site.phoneHref}`}>{site.phone}</a></dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
          </div>
          <div>
            <dt>Hours</dt>
            <dd>{site.hours}</dd>
          </div>
          <div>
            <dt>Follow</dt>
            <dd>
              {
                site.social.map((item, index) => (
                  <>
                    {index > 0 && ' · '}
                    <a href={item.href}>{item.label}</a>
                  </>
                ))
              }
            </dd>
          </div>
        </dl>

        <a class="link-cta" href={site.whatsappHref} style="margin-top: 2rem;">
          Chat on WhatsApp
        </a>
      </div>

      <div class="form-card">
        <h2>Send an enquiry</h2>
        <p>Fields marked with * are required.</p>

        <form class="form-grid" data-mockup-form>
          <div class="field">
            <label for="name">Full name *</label>
            <input id="name" name="name" type="text" autocomplete="name" required />
          </div>

          <div class="field">
            <label for="phone">Phone *</label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" required />
          </div>

          <div class="field field--full">
            <label for="email">Email *</label>
            <input id="email" name="email" type="email" autocomplete="email" required />
          </div>

          <div class="field field--full">
            <label for="interest">I am interested in</label>
            <select id="interest" name="interest">
              <option>The Courtyard — 3 BHK</option>
              <option>The Courtyard — 4 BHK</option>
              <option>Commercial or retail space</option>
              <option>Something else</option>
            </select>
          </div>

          <div class="field field--full">
            <label for="message">Tell us a little more</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              placeholder="Preferred unit, budget range, timeline, or the stage you are at."
            ></textarea>
          </div>

          <div class="field field--full">
            <label class="checkbox">
              <input type="checkbox" name="consent" required />
              <span>I agree to be contacted about this enquiry. My details will not be used for anything else.</span>
            </label>
          </div>

          <div class="field field--full">
            <button class="btn" type="submit">Send enquiry</button>
            <p class="form-note">
              Design preview — this form is not connected yet. Email and WhatsApp
              are wired up in the final build.
            </p>
          </div>
        </form>
      </div>
    </div>

    <div class="container contact-map">
      <div class="map-placeholder" role="img" aria-label="Map placeholder for the head office">
        <span>
          Map embed placeholder<br />
          {site.address.lines.join(', ')}
        </span>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-mockup-form]');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    window.alert(
      'Design preview — the enquiry form is not connected yet. Email and WhatsApp are added in the final build.',
    );
  });
</script>
