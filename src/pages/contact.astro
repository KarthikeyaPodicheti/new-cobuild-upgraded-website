---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { url } from '../lib/paths';
---

<BaseLayout
  title="Contact"
  description="Talk to NewBuild about a home, commercial space or a site visit."
>
  <!-- Full-width dark panel: form left, line art right — the reference layout -->
  <section class="contact-hero">
    <div class="container contact-hero__grid">
      <div>
        <h1 class="contact-hero__title" data-reveal="left">
          Let's talk about <em>your next home</em>
        </h1>
        <p class="contact-hero__lead" data-reveal="left" style="transition-delay:150ms">
          If you have questions or would like to learn more, please don't hesitate to reach out. We
          look forward to hearing from you.
        </p>

        <form class="form form--dark" data-mockup-form style="margin-top:var(--space-2xl)" novalidate>
          <p class="form__required">All fields are required unless marked optional.</p>
          <div class="form-grid">
            <div class="field field--full">
              <label for="name">Full Name</label>
              <input
                id="name"
                name="name"
                type="text"
                autocomplete="name"
                enterkeyhint="next"
                placeholder="Enter your name here"
                required
                data-error="name-error"
                aria-invalid="false"
              />
              <span id="name-error" class="field__error">Please provide your full name.</span>
            </div>
            <div class="field">
              <label for="email">Email</label>
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                inputmode="email"
                enterkeyhint="next"
                placeholder="name@domain.com"
                required
                data-error="email-error"
                aria-invalid="false"
              />
              <span id="email-error" class="field__error">Please enter a valid email address.</span>
            </div>
            <div class="field">
              <label for="phone">Phone</label>
              <input
                id="phone"
                name="phone"
                type="tel"
                autocomplete="tel"
                inputmode="tel"
                enterkeyhint="next"
                placeholder="+91 90000 00000"
                required
                data-error="phone-error"
                aria-invalid="false"
              />
              <span id="phone-error" class="field__error">Please enter a valid phone number.</span>
            </div>
            <div class="field field--full">
              <label for="interest">I am interested in</label>
              <select id="interest" name="interest">
                <option>The Courtyard — 3 BHK</option>
                <option>The Courtyard — 4 BHK</option>
                <option>Commercial or retail space</option>
                <option>Something else</option>
              </select>
            </div>
            <div class="field field--full">
              <label for="message">Message <span class="field__optional">(optional)</span></label>
              <textarea id="message" name="message" rows="3" placeholder="Preferred unit, budget range, timeline."></textarea>
            </div>
            <div class="field field--full">
              <label class="checkbox">
                <input type="checkbox" name="consent" required data-error="consent-error" aria-invalid="false" />
                <span>I agree to be contacted about this enquiry. My details will not be used for anything else.</span>
              </label>
              <span id="consent-error" class="field__error">Please accept the consent check to proceed.</span>
            </div>
          </div>

          <div class="form__submit-row">
            <button class="link link--button" type="submit">Submit enquiry</button>
          </div>

          <p class="form__note">
            Design preview — write to us directly at
            <a href={`mailto:${site.email}`}>{site.email}</a> or call <a href={`tel:${site.phoneHref}`}>{site.phone}</a>.
          </p>
        </form>
      </div>

      <div class="contact-hero__art" aria-hidden="true">
        <img src={url('/images/illustration-tower.svg')} alt="" width="524" height="480" />
      </div>
    </div>
  </section>

  <!-- Declarative HTML <dialog closedby="any"> modal for accessible form submission feedback -->
  <dialog class="modal-dialog" id="contact-dialog" aria-labelledby="dialog-title" aria-modal="true" closedby="any">
    <div class="modal-dialog__surface">
      <div class="modal-dialog__badge" aria-hidden="true">✓</div>
      <h2 id="dialog-title" class="section-title section-title--sm">Enquiry Registered</h2>
      <p class="body-text" style="margin-top:var(--space-md)">
        Thank you for contacting NewBuild. We have recorded your interest. In the production release, this forwards directly to our project sales desk in Hyderabad for verified documentation follow-up.
      </p>
      <div class="modal-dialog__actions">
        <form method="dialog">
          <button class="link link--button" type="submit" autofocus>Dismiss</button>
        </form>
      </div>
    </div>
  </dialog>

  <!-- Corporate office -->
  <section class="section">
    <div class="container">
      <h2 class="section-title section-title--sm" data-reveal="left">Corporate office</h2>

      <div class="office-grid">
        <div data-reveal="left" style="transition-delay:100ms">
          <h3 class="office-grid__city">Hyderabad</h3>
          <p class="office-grid__address">{site.address.lines.join(', ')}</p>
        </div>

        <dl class="office-grid__details" data-reveal="left" style="transition-delay:150ms">
          <div>
            <dt>Phone</dt>
            <dd><a href={`tel:${site.phoneHref}`}>{site.phone}</a></dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
          </div>
          <div>
            <dt>Hours</dt>
            <dd>{site.hours}</dd>
          </div>
        </dl>
      </div>

      <a class="link" href={url('/projects')} style="margin-top:var(--space-2xl)">Browse the projects</a>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  const setupContactForm = () => {
    const form = document.querySelector('[data-mockup-form]');
    const dialog = document.getElementById('contact-dialog');
    if (!form) return;

    // Modern Web Guidance: sync visual :user-invalid with programmatic aria-invalid
    const linkError = (el, shown) => {
      const errorId = el.dataset.error;
      if (!errorId) return;
      const ids = (el.getAttribute('aria-describedby') || '').split(/\s+/).filter((id) => id && id !== errorId);
      if (shown) ids.push(errorId);
      if (ids.length) el.setAttribute('aria-describedby', ids.join(' '));
      else el.removeAttribute('aria-describedby');
    };

    const syncField = (el) => {
      if (!el.matches('input, select, textarea')) return;
      const invalid = el.matches(':user-invalid');
      if (invalid) {
        el.setAttribute('aria-invalid', 'true');
        linkError(el, true);
      } else {
        el.setAttribute('aria-invalid', 'false');
        linkError(el, false);
      }
    };

    form.querySelectorAll('input, select, textarea').forEach((el) => {
      el.addEventListener('blur', () => syncField(el));
      el.addEventListener('input', () => {
        if (el.getAttribute('aria-invalid') === 'true') syncField(el);
      });
      el.addEventListener('change', () => syncField(el));
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      if (!form.checkValidity()) {
        const firstInvalid = form.querySelector(':invalid');
        if (firstInvalid) {
          firstInvalid.focus();
          syncField(firstInvalid);
        }
        return;
      }

      // Valid: show native modal dialog
      if (dialog && typeof dialog.showModal === 'function') {
        dialog.showModal();
        if (!('closedBy' in HTMLDialogElement.prototype)) {
          dialog.addEventListener('click', (event) => {
            if (event.target === dialog) dialog.close();
          });
        }
      }
      form.reset();
      form.querySelectorAll('input, select, textarea').forEach((el) => {
        el.setAttribute('aria-invalid', 'false');
        linkError(el, false);
      });
    });
  };

  document.addEventListener('astro:page-load', setupContactForm);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupContactForm);
  } else {
    setupContactForm();
  }
</script>
