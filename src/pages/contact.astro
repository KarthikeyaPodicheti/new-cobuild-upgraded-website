---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Contact"
  description="Talk to NewBuild about a home, commercial space or a site visit."
>
  <section class="hero" data-reveal>
    <div class="hero__bg" aria-hidden="true">
      <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/e/e5/Exterior_view_of_the_illuminated_facade_of_Maison_Herm%C3%A8s%2C_Ginza%2C_Tokyo%2C_Japan.jpg/1280px-Exterior_view_of_the_illuminated_facade_of_Maison_Herm%C3%A8s%2C_Ginza%2C_Tokyo%2C_Japan.jpg" alt="" width="1280" height="853" loading="eager" />
    </div>
    <div class="container hero__inner">
      <div class="hero__content">
        <span class="hero__eyebrow">Contact</span>
        <h1>Ask for a visit or the project details</h1>
        <p class="lead">
          Send a message if you want the project dossier, a site visit, or answers to specific questions. We reply within one working day.
        </p>
      </div>
    </div>
  </section>

  <section class="offer" data-reveal>
    <div class="container">
      <div class="offer__grid">
        <div class="offer__content">
          <h2>Reach us</h2>
          <dl class="offer__meta" style="margin-top: var(--space-lg);">
            <dt>Head office</dt>
            <dd>{site.address.lines.join(', ')}</dd>
            <dt>Phone</dt>
            <dd><a href={`tel:${site.phoneHref}`}>{site.phone}</a></dd>
            <dt>Email</dt>
            <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
            <dt>Hours</dt>
            <dd>{site.hours}</dd>
          </dl>
        </div>

        <div class="form-card" data-reveal>
          <h2>Send an enquiry</h2>
          <p class="form-hint">Fields marked with * are required.</p>
          <form class="form-grid" data-mockup-form>
            <div class="field">
              <label for="name">Full name *</label>
              <input id="name" name="name" type="text" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="phone">Phone *</label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" required />
            </div>
            <div class="field field--full">
              <label for="email">Email *</label>
              <input id="email" name="email" type="email" autocomplete="email" required />
            </div>
            <div class="field field--full">
              <label for="interest">I am interested in</label>
              <select id="interest" name="interest">
                <option>The Courtyard — 3 BHK</option>
                <option>The Courtyard — 4 BHK</option>
                <option>Commercial or retail space</option>
                <option>Something else</option>
              </select>
            </div>
            <div class="field field--full">
              <label for="message">Message</label>
              <textarea id="message" name="message" rows="5" placeholder="Preferred unit, budget range, timeline, or questions you want answered."></textarea>
            </div>
            <div class="field field--full">
              <label class="checkbox">
                <input type="checkbox" name="consent" required />
                <span>I agree to be contacted about this enquiry. My details will not be used for anything else.</span>
              </label>
            </div>
            <div class="field field--full">
              <button class="btn btn--primary" type="submit">Request details / Book visit</button>
              <p class="form-note">Design preview — this form is not connected yet. Email and WhatsApp are wired up in the final build.</p>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-mockup-form]');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    window.alert('Design preview — the enquiry form is not connected yet. Email and WhatsApp are added in the final build.');
  });
</script>
