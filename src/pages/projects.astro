---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import CtaBand from '../components/CtaBand.astro';
import { projects, trackRecord } from '../data/projects';
import { url } from '../lib/paths';

const flagship = projects[0];
---

<BaseLayout
  title="Projects"
  description="The current NewBuild launch, plus developments delivered by the promoters."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Projects</p>
      <h1>Built, building, and next.</h1>
      <p class="lead">
        A working view of the portfolio: the project selling now, and earlier
        work delivered by the promoters.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Now selling"
        title="The current launch"
        intro="A gated residential community in Kondapur, planned around a shaded central court."
      />

      {flagship && <FeaturedProject project={flagship} />}

      <p class="note" style="margin-top: 2.5rem;">
        Placeholder project name, specifications and imagery. The Client supplies
        verified facts, the RERA number and photography before launch.
      </p>
    </div>
  </section>

  <section class="track">
    <div class="container">
      <SectionHeading
        eyebrow="Track record"
        title="Delivered by the promoters"
        intro="Earlier developments completed by the team behind NewBuild, shown with attribution."
        dark
      />

      <div class="track__grid">
        {
          trackRecord.map((entry) => (
            <article class="track-card">
              <div class="track-card__media">
                <img
                  src={url(entry.image)}
                  alt={`Illustration of ${entry.title}`}
                  width="640"
                  height="480"
                  loading="lazy"
                />
              </div>
              <div class="track-card__body">
                <h3>{entry.title}</h3>
                <p class="track-card__meta">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    aria-hidden="true"
                  >
                    <path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11Z" />
                    <circle cx="12" cy="10" r="2.5" />
                  </svg>
                  {entry.location} · {entry.year}
                </p>
                <p>{entry.note}</p>
              </div>
            </article>
          ))
        }
      </div>

      <p class="note note--light">
        Placeholder entries. Replace with verified names, years and photography,
        or remove this section if no attributable track record exists.
      </p>
    </div>
  </section>

  <CtaBand
    title="Ask for the full project dossier"
    body="Approvals, specifications, floor plans and the milestone schedule — sent before you book a site visit."
    ctaLabel="Request the dossier"
  />
</BaseLayout>
