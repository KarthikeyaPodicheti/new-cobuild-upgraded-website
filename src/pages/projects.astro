---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import CtaBand from '../components/CtaBand.astro';
import { projects, trackRecord } from '../data/projects';
import { url } from '../lib/paths';

const flagship = projects[0];
---

<BaseLayout
  title="Projects"
  description="The current NewBuild launch, plus developments delivered by the promoters."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Projects</p>
      <h1>Built, building, and next.</h1>
      <p class="lead">
        A working view of the portfolio: the project selling now, and earlier
        work delivered by the promoters.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Now selling</p>
      <h2 style="margin-top: 0.85rem; font-size: clamp(1.85rem, 3.5vw, 2.6rem);">
        The current launch
      </h2>
      <div style="margin-top: 2rem;">
        {flagship && <FeaturedProject project={flagship} />}
      </div>
      <p class="note" style="margin-top: 2rem;">
        Placeholder project name, specifications and imagery. The Client
        supplies verified facts, the RERA number and photography before launch.
      </p>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <p class="eyebrow">Track record</p>
      <h2 style="margin-top: 0.85rem; font-size: clamp(1.85rem, 3.5vw, 2.6rem);">
        Delivered by the promoters
      </h2>
      <p class="lead" style="margin-top: 0.75rem; max-width: 60ch;">
        Earlier developments completed by the team behind NewBuild, shown with
        attribution.
      </p>

      <div class="grid grid--3" style="margin-top: 2rem;">
        {
          trackRecord.map((entry) => (
            <article class="track-card">
              <div class="track-card__media">
                <img
                  src={url(entry.image)}
                  alt={`Illustration of ${entry.title}`}
                  width="640"
                  height="440"
                  loading="lazy"
                />
              </div>
              <div class="track-card__body">
                <p class="project-card__meta">
                  {entry.location} · {entry.year}
                </p>
                <h3>{entry.title}</h3>
                <p>{entry.note}</p>
              </div>
            </article>
          ))
        }
      </div>

      <p class="note" style="margin-top: 2rem;">
        Placeholder entries. Replace with verified names, years and photography,
        or remove this section if no attributable track record exists.
      </p>
    </div>
  </section>

  <CtaBand
    title="Ask for the full project dossier"
    body="Approvals, specifications, floor plans and the milestone schedule — sent before you book a site visit."
  />
</BaseLayout>
