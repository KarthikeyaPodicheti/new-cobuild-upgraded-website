---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects, trackRecord, photos } from '../data/projects';
import { url } from '../lib/paths';

const flagship = projects[0];

const delivered = [
  { ...trackRecord[0], alt: 'Massing model of courtyard villas' },
  { ...trackRecord[1], alt: 'City skyline at dawn' },
  { ...trackRecord[2], alt: 'Glass office building at blue hour' },
];
---

<BaseLayout
  title="Projects"
  description="The current NewBuild launch, plus developments delivered by the promoters."
>
  <section class="page-hero">
    <div class="page-hero__art" aria-hidden="true">
      <img src={url('/images/illustration-trees.svg')} alt="" width="600" height="220" loading="lazy" />
    </div>
    <div class="container">
      <span class="eyebrow">Projects</span>
      <h1 class="page-hero__title" data-reveal="left">Current work and past delivery</h1>
      <p class="lead page-hero__lead" data-reveal="left" style="transition-delay:150ms">
        See the current launch and the work delivered earlier by the promoters. Each listing includes the
        details we can share now and the documents available on request.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <h2 class="section-title section-title--sm" data-reveal="left">Now selling in Kondapur</h2>

      {flagship && (
        <article class="row" style="margin-top:var(--space-2xl)">
          <div class="row__media" data-reveal="left">
            <a href={url(`/projects/${flagship.slug}`)}>
              <img src={photos.courtyard} alt="Curved blue glass facade" width="1280" height="759" loading="lazy" decoding="async" />
            </a>
          </div>
          <div class="row__body" data-reveal="left" style="transition-delay:100ms">
            <h3 class="row__title">{flagship.title}</h3>
            <p class="row__location">
              <img src={url('/images/pin.svg')} alt="" width="18" height="18" loading="lazy" />
              {flagship.location}
            </p>
            <p class="row__text">{flagship.summary}</p>
            <dl class="row__meta">
              {flagship.facts.slice(0, 4).map((fact) => (
                <>
                  <dt>{fact.label}</dt>
                  <dd>{fact.value}</dd>
                </>
              ))}
            </dl>
            <a class="link row__link" href={url(`/projects/${flagship.slug}`)}>View project details</a>
          </div>
        </article>
      )}

      <p class="note">
        Placeholder project name, specifications and imagery. Verified facts, the RERA number and
        photography replace these before launch.
      </p>
    </div>
  </section>

  <section class="band band--dark section section--roomy">
    <div class="container">
      <h2 class="section-title" data-reveal="left">Delivered by the promoters</h2>

      <div class="grid-3" data-stagger style="margin-top:var(--space-2xl)">
        {delivered.map((entry) => (
          <article class="card">
            <span class="card__media">
              <img src={entry.image} alt={entry.alt} width="1280" height="759" loading="lazy" decoding="async" />
            </span>
            <span class="card__meta">{entry.year}</span>
            <h3 class="card__title">{entry.title}</h3>
            <p class="card__text">{entry.note}</p>
          </article>
        ))}
      </div>

      <p class="note" style="border-color:var(--color-muted-2);color:var(--color-on-dark-muted)">
        Placeholder entries. Replace with verified names, years and photography, or remove this section if
        there is no attributable record.
      </p>
    </div>
  </section>

  <section class="closer">
    <div class="closer__media" aria-hidden="true">
      <img src={photos.courtyard} alt="" width="1280" height="759" loading="lazy" decoding="async" />
    </div>
    <div class="container closer__inner">
      <h2 class="closer__title" data-reveal="grow-big">Ask for the full project dossier</h2>
      <p class="closer__text" data-reveal="grow" style="transition-delay:200ms">
        Approvals, specifications, floor plans and the milestone schedule — sent before you book a site visit.
      </p>
      <a class="link link--light" href={url('/contact')} data-reveal="bottom">Request the dossier</a>
    </div>
  </section>
</BaseLayout>
