---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects, trackRecord } from '../data/projects';
import { url } from '../lib/paths';

const flagship = projects[0];
---

<BaseLayout
  title="Projects"
  description="The current NewBuild launch, plus developments delivered by the promoters."
>
  <section class="hero" data-reveal>
    <div class="hero__bg" aria-hidden="true">
      <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/e/e5/Exterior_view_of_the_illuminated_facade_of_Maison_Herm%C3%A8s%2C_Ginza%2C_Tokyo%2C_Japan.jpg/1280px-Exterior_view_of_the_illuminated_facade_of_Maison_Herm%C3%A8s%2C_Ginza%2C_Tokyo%2C_Japan.jpg" alt="" width="1280" height="853" loading="eager" />
    </div>
    <div class="container hero__inner">
      <div class="hero__content">
        <span class="hero__eyebrow">Projects</span>
        <h1>Current work and past delivery</h1>
        <p class="lead">
          See the current launch and the work delivered earlier by the promoters. Each listing includes the details we can share now and the documents available on request.
        </p>
      </div>
    </div>
  </section>

  <section class="offer" data-reveal>
    <div class="container">
      <header class="offer__header">
        <h2>Now selling in Kondapur</h2>
      </header>
      {flagship && (
        <div class="offer__grid">
          <div class="offer__media">
            <a href={url(`/projects/${flagship.slug}/`)} data-slot="project-featured" data-alt={`${flagship.title} illustration`} style="display:block; --slot-img: url('https://upload.wikimedia.org/wikipedia/commons/thumb/a/a6/Fragment_of_160_Front_Street_West%2C_Toronto.jpg/1280px-Fragment_of_160_Front_Street_West%2C_Toronto.jpg');">
              <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/a/a6/Fragment_of_160_Front_Street_West%2C_Toronto.jpg/1280px-Fragment_of_160_Front_Street_West%2C_Toronto.jpg" alt="Curved blue glass facade" width="1280" height="853" loading="lazy" />
            </a>
          </div>
          <div class="offer__content">
            <dl class="offer__meta">
              {flagship.facts.slice(0, 4).map((fact) => (
                <>
                  <dt>{fact.label}</dt>
                  <dd>{fact.value}</dd>
                </>
              ))}
            </dl>
            <p class="offer__description">{flagship.summary}</p>
            <a href={url(`/projects/${flagship.slug}/`)} class="offer__cta">View project details</a>
          </div>
        </div>
      )}
      <p class="offer__note">Placeholder project name, specifications, and imagery. Verified facts, the RERA number, and photography replace these before launch.</p>
    </div>
  </section>

  <section class="case-study" data-reveal>
    <div class="container">
      <header class="case-study__header">
        <h2>Delivered by the promoters</h2>
      </header>
      <div class="what-we-do__grid" data-stagger>
        {trackRecord.map((entry) => (
          <article class="what-we-do__item">
            <span class="what-we-do__num">{entry.year}</span>
            <h3>{entry.title}</h3>
            <p>{entry.location}</p>
            <p>{entry.note}</p>
          </article>
        ))}
      </div>
      <p class="case-study__note">Placeholder entries. Replace with verified names, years, and photography, or remove this section if there is no attributable record.</p>
    </div>
  </section>

  <section class="close" data-reveal>
    <div class="container">
      <h2>Ask for the full project dossier</h2>
      <p class="lead">Approvals, specifications, floor plans and the milestone schedule — sent before you book a site visit.</p>
      <div class="close__contact">
        <a href={url('/contact')}>Request the dossier</a>
        <a href="tel:+914012345678">Call us</a>
      </div>
    </div>
  </section>
</BaseLayout>
